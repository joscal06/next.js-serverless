# Copia este archivo como .env.local y completa los valores de tu proyecto
# (Supabase Dashboard → Project Settings → API).

# URL del proyecto de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública "anon" / "publishable". Solo se usa en el servidor
# (Server Components y Server Actions); el acceso lo controlan las políticas RLS.
SUPABASE_ANON_KEY=tu-clave-anon

# (Opcional) URL pública del sitio, para metadatos Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
